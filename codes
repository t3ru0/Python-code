# PRACTICAL 5 - VARIANCE AND STANDARD DEVIATION

import statistics as st

data = [10, 20, 30, 40, 100]

# Variance
v = st.variance(data)

# Standard Deviation
sd = st.stdev(data)

# Outliers
outliers = [x for x in data if abs(x - st.mean(data)) > 2 * sd]

print("Variance:", v)
print("Standard Deviation:", round(sd, 2))
print("Outliers:", outliers)

# PRACTICAL 6 - PROBABILITY OF EVENTS

# Create a deck of cards
cards = list(range(1, 53))

# Find total cards
total = len(cards)

# Find probability of drawing an Ace
aces = [1, 14, 27, 40]

probability = len(aces) / total

print("Total Cards:", total)
print("Number of Aces:", len(aces))
print("Probability:", probability)


# PRACTICAL 7 - GRADIENT, DIVERGENCE AND CURL

import sympy as sp

x, y, z = sp.symbols('x y z')

f = x**2 + y**2 + z**2

F = [x**2, y**2, z**2]

# Gradient
gradient = [sp.diff(f, v) for v in (x, y, z)]

# Divergence
divergence = sum(sp.diff(F[i], v) for i, v in enumerate((x, y, z)))

# Curl
curl = [
    sp.diff(F[2], y) - sp.diff(F[1], z),
    sp.diff(F[0], z) - sp.diff(F[2], x),
    sp.diff(F[1], x) - sp.diff(F[0], y)
]

print("Gradient:", gradient)
print("Divergence:", divergence)
print("Curl:", curl)