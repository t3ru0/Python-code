
# PRACTICAL 1 - SET OPERATIONS

def practical1():
    A = {1, 2, 3, 4}
    B = {3, 4, 5, 6}

    print("Union:", A | B)
    print("Intersection:", A & B)
    print("Difference:", A - B)
    print("Cartesian Product:", [(x, y) for x in A for y in B])


# PRACTICAL 2 - RELATION PROPERTIES

def practical2():
    A = {1, 2}
    R = {(1, 1), (2, 2), (1, 2), (2, 1)}

    reflexive = all((x, x) in R for x in A)
    symmetric = all((y, x) in R for x, y in R)

    transitive = all(
        (x, z) in R
        for x, y in R
        for a, z in R
        if y == a
    )

    print("Reflexive:", reflexive)
    print("Symmetric:", symmetric)
    print("Transitive:", transitive)
    print("Equivalence Relation:", reflexive and symmetric and transitive)


# PRACTICAL 3 - INJECTIVE, SURJECTIVE AND BIJECTIVE

def practical3():
    A = {1, 2, 3}
    B = {2, 4, 6}

    f = {1: 2, 2: 4, 3: 6}

    values = list(f.values())

    injective = len(values) == len(set(values))
    surjective = set(values) == B
    bijective = injective and surjective

    print("Injective:", injective)
    print("Surjective:", surjective)
    print("Bijective:", bijective)


